# ── SECRETS (never commit) ────────────────────────────────────────────
# All user config/secrets live in ~/.hestia/ (outside this repo) — but guard anyway:
.hestia/
*.env
!*.env.example
.mcp.json
!.mcp.json.template
# Per-user permission allows (Notion/Strava/gcal connector ids) — added by /setup:
.claude/settings.local.json
*token*
*secret*
*.pem
*.key

# ── PERSONAL DATA (this is a PUBLIC repo — no real user data ever) ─────
# The vault ships only fictional seed content. Real data is ignored:
vault/Raw/health/*.json
vault/Raw/life-signals/*.json
vault/Projects/Finanzas/Resumenes/*
!vault/Projects/Finanzas/Resumenes/.gitkeep
!vault/Projects/Finanzas/Resumenes/README.md
# Never commit real bank statements / exports
*.xls
*.xlsx
*.pdf
*.csv

# ── OBSIDIAN ──────────────────────────────────────────────────────────
vault/.obsidian/workspace*.json
vault/.obsidian/cache

# ── PYTHON ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── OS / EDITOR ───────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/
